# Relasy Environment Variables Configuration
# Copy this file to .env.local for local development, or paste the same
# variables into Vercel > Settings > Environment Variables.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Secret for session signing (minimum 32 characters).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=development-session-secret-change-in-production-min-32-chars

# PostgreSQL connection string from Supabase.
#
# IMPORTANT: use the POOLER host, not the direct database host. The direct
# host is IPv6-only and will not connect reliably from Vercel.
# Find it in Supabase > Project Settings > Database > Connection string >
# "Transaction pooler" (port 6543).
#
# Format:
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
