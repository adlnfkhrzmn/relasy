# Relasy Environment Variables Configuration
# Copy this file to .env.local for local development.

# Application URL (configured for port 3005)
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Secret for session signing and auth encryption (at least 32 characters in production)
SESSION_SECRET=development-session-secret-change-in-production-min-32-chars

# Database path (relative to project root or absolute path)
DATABASE_PATH=./data/relasy.db
